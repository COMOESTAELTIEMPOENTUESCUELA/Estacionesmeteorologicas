# Copiá este archivo como .env y completalo:   cp .env.example .env
# .env NO se sube a GitHub (está en .gitignore).

# Contraseña de la base de datos. Generá una con:  openssl rand -hex 16
DB_PASSWORD=cambiame

# Dónde guardar cada cosa en la PC (ver docs/01-preparar-la-pc.md):
DB_DIR=/srv/meteo/db                 # SSD: base de datos
BACKUP_DIR=/mnt/archivo/backups      # disco de 500 GB
ARCHIVO_DIR=/mnt/archivo/archivo     # disco de 500 GB: imágenes de satélite, etc.

LOG_LEVEL=INFO

# Contraseña para el visualizador (opcional). Si se dejan vacíos, la página
# no pide nada. Conviene ponerla antes de abrirla al público con Funnel.
WEB_USUARIO=
WEB_CLAVE=

# Copia pública de las cartas (servicio web-cartas, puerto 8081 solo local).
# Si se completan, también pide usuario y contraseña (distintos de los del
# visualizador completo, para poder compartirlos sin darle acceso a todo).
CARTAS_USUARIO=
CARTAS_CLAVE=
